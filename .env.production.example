# ==============================================================================
# VERNIKA ENTERPRISES - PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# Copy this file to .env.local on your production hosting provider (Netlify / Vercel).
# NEVER commit real credentials to Git.
# ==============================================================================

# Database: MongoDB Atlas (M0 Free Tier or higher, NOT localhost)
# Example: mongodb+srv://vernika_app:SECURE_PASSWORD@cluster0.abcde.mongodb.net/vernika_prod?retryWrites=true&w=majority
MONGODB_URI=

# Public Site URL (Must match your production custom domain)
NEXT_PUBLIC_SITE_URL=https://vernika.art

# Seller Location (Production build will fail if empty or "[YOUR CITY]")
NEXT_PUBLIC_SELLER_CITY=Faridabad
NEXT_PUBLIC_SELLER_STATE=Haryana

# Admin Authentication
ADMIN_EMAIL=admin@vernika.art
# Generate with: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
ADMIN_PASSWORD_HASH=
# Minimum 32 random characters: openssl rand -base64 32
SESSION_SECRET=

# Razorpay Payment Gateway (Start in TEST mode: rzp_test_..., switch to LIVE after KYC)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary Media Storage (For admin image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend Transactional Email (For order receipts and admin COD notifications)
RESEND_API_KEY=

# Upstash Redis (For distributed rate limiting across serverless functions)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
